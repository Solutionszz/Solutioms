--=====================================================================
--  AIM ASSIST + ANTI-CHEAT  —  arquivo único
--
--  INSTALAÇÃO:
--   1. Game Settings > Security > Allow HTTP Requests = true
--   2. Command bar: game:GetService("ServerScriptService").LoadStringEnabled = true
--   3. Script no ServerScriptService com:
--      loadstring(game:HttpGet("SUA_URL_RAW"))()
--
--  A mira gruda no inimigo mais próximo. Não atira sozinha,
--  não mexe na câmera e não mexe no movimento do personagem.
--  PC = mouse | Mobile = toque + botão FIRE | Controle = centro + R2
--=====================================================================

local VERSION = "1.0.0"

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")

--=====================================================================
--  CONFIG  (única fonte da verdade — vai pro cliente automaticamente)
--=====================================================================
local CONFIG = {
	-- aquisição de alvo
	MaxDistance        = 250,    -- studs: alcance do grude
	MaxAngleDeg        = 35,     -- cone de aquisição
	SnapAngleDeg       = 6,      -- dentro disto, trava 100%
	MinBlend           = 0.30,   -- correção mínima na borda do cone
	AssistTurnRateDeg  = 22,     -- graus/s: velocidade de giro da correção
	TeamCheck          = true,
	RequireLineOfSight = true,
	FireCooldown       = 0.10,

	-- anti-cheat (servidor)
	AntiCheat          = true,
	Tolerance          = 1.25,   -- folga geral (lag / jitter)
	OriginSlack        = 14,     -- studs de folga origem cliente vs. cabeça
	MaxTurnRateDeg     = 600,    -- graus/s: teto de giro da mira
	DivergenceDeg      = 3,      -- tolerância vs. o assist recalculado
	MaxSuspicion       = 6,
	SuspicionDecay     = 1,      -- suspeitas perdidas por segundo
	FlagInterval       = 0.2,
	KickOnSuspicion    = false,  -- DESLIGADO por padrão
	Verbose            = false,

	FolderName         = "AimAssist",
	RemoteName         = "AimAssistFire",
	ClientName         = "AimAssistClient",
}

--=====================================================================
--  CÓDIGO DO CLIENTE (injetado como LocalScript em cada jogador)
--=====================================================================
local CLIENT_TEMPLATE = [==[
--!nocheck
local CONFIG = __CONFIG__

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local UserInputService  = game:GetService("UserInputService")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remote = ReplicatedStorage:WaitForChild(CONFIG.FolderName):WaitForChild(CONFIG.RemoteName)

local player = Players.LocalPlayer
local mouse  = player:GetMouse()
local camera = Workspace.CurrentCamera

local SNAP = math.rad(CONFIG.SnapAngleDeg)
local CONE = math.rad(CONFIG.MaxAngleDeg)

local function angleBetween(a, b)
	local d = math.clamp(a.Unit:Dot(b.Unit), -1, 1)
	return math.acos(d)
end

local function blend(raw, targetDir, angle)
	if angle <= SNAP then return targetDir.Unit end
	local f = math.clamp((CONE - angle) / math.max(CONE - SNAP, 1e-4), 0, 1)
	f = CONFIG.MinBlend + (1 - CONFIG.MinBlend) * f
	return raw.Lerp(targetDir, f).Unit
end

local function rotateTowards(from, to, maxRad)
	local a = angleBetween(from, to)
	if a <= maxRad or a < 1e-6 then return to.Unit end
	local axis = from.Unit:Cross(to.Unit)
	if axis.Magnitude < 1e-6 then return to.Unit end
	return (CFrame.fromAxisAngle(axis.Unit, maxRad) * from.Unit).Unit
end

local function rotateBy(from, to, vec)
	local a = angleBetween(from, to)
	if a < 1e-6 then return vec.Unit end
	local axis = from.Unit:Cross(to.Unit)
	if axis.Magnitude < 1e-6 then return vec.Unit end
	return (CFrame.fromAxisAngle(axis.Unit, a) * vec).Unit
end

-- estado
local inputKind = "mouse"          -- mouse | touch | gamepad
local touchAim  = Vector2.new(0, 0)
local lastFire  = 0
local assistedDir, prevRaw
local curOrigin, curRaw, curFinal, curTarget

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "AimAssistUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 100
gui.Parent = player:WaitForChild("PlayerGui")

local crosshair = Instance.new("Frame")
crosshair.AnchorPoint = Vector2.new(0.5, 0.5)
crosshair.Size = UDim2.fromOffset(26, 26)
crosshair.BackgroundTransparency = 1
crosshair.Visible = false
crosshair.Parent = gui

local ring = Instance.new("Frame")
ring.Size = UDim2.fromScale(1, 1)
ring.BackgroundTransparency = 1
ring.Parent = crosshair

local ringStroke = Instance.new("UIStroke")
